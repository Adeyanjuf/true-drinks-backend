// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id              String      @id @default(uuid())
  name            String
  username        String      @unique
  email           String      @unique
  password        String
  isVerified      Boolean     @default(false)
  otp_hashed      String?
  otp_expiresAt   DateTime?
  role            Role        @default(CUSTOMER)

  passwordResetTokens PasswordResetToken[]
  refreshTokens RefreshToken[]
  cart Cart?
  address UserAddress?
  orders Order[]
  statusChanges OrderStatusHistory[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // hashed
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // hashed, same principle as password reset tokens
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String   @id @default(cuid())
  name            String
  description     String?
  images          String[]
  brand           String?
  pricePence      Int // price in pence, before discount
  discountPercent Int      @default(0) // 0-100, applied to pricePence
  weightGrams     Int // weight per unit, used for order weight at checkout
  abv             Float? // alcohol by volume, %
  isAgeRestricted Boolean  @default(false)
  stock           Int      @default(0) // in stock when > 0
  categoryId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([pricePence])
  @@index([abv])
  @@index([brand])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  token     String?    @unique // guest carts only, sent as x-cart-token
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

enum PromoType {
  PERCENT
  FIXED
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique // stored uppercase
  type          PromoType
  value         Int // percent (1-100) or pence
  minSpendPence Int       @default(0)
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum OrderStatus {
  PACKAGING
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PendingCheckoutStatus {
  CREATED
  COMPLETED
  FAILED
}

// Server-side snapshot taken when the PaymentIntent is created; the Order is built from it
// when Stripe confirms payment. Snapshot (which holds PII) is blanked once completed.
model PendingCheckout {
  id                    String                @id @default(cuid())
  snapshot              Json
  stripePaymentIntentId String?               @unique
  status                PendingCheckoutStatus @default(CREATED)
  ageVerifiedAt         DateTime?
  ageMethod             String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

// Orders are never hard-deleted (HMRC: keep sales records ~6 years).
model Order {
  id                    String      @id @default(cuid())
  trackingId            String      @unique
  userId                String?
  email                 String
  name                  String
  addressLine1          String
  addressLine2          String?
  city                  String
  postcode              String
  phone                 String?
  country               String      @default("GB")
  status                OrderStatus @default(PACKAGING)
  subtotalPence         Int
  discountPence         Int
  shippingPence         Int
  totalPence            Int
  totalWeightGrams      Int
  promoCode             String?
  stripePaymentIntentId String      @unique
  ageVerifiedAt         DateTime?
  ageMethod             String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([userId])
  @@index([email])
  @@index([status])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String?
  name            String
  listPricePence  Int
  discountPercent Int
  unitPricePence  Int
  weightGrams     Int
  quantity        Int
  isAgeRestricted Boolean

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String? // admin who made the change; null for the initial status
  changedAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model UserAddress {
  id        String   @id @default(cuid())
  userId    String   @unique
  line1     String
  line2     String?
  city      String
  postcode  String
  phone     String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
